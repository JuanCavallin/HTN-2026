    "check:graph-synthesis": "tsx scripts/graph-synthesis.check.ts",
    "check:graph-context": "tsx scripts/graph-context.check.ts",
    "check:graph-critique": "tsx scripts/graph-critique.check.ts",
    "check:graphs": "tsx scripts/stored-graphs.check.ts",
    "check:analytics": "tsx scripts/analytics-parity.check.ts",
    "check:benchmark": "tsx scripts/benchmark.check.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "check:jev:decisions": "tsx scripts/jev-decisions.check.ts",
    "check:agent-single-run": "tsx scripts/agent-single-run.check.ts",
    "check:model-gateway": "tsx scripts/model-gateway.check.ts",
    "check:mcp-gateway": "tsx scripts/mcp-gateway.check.ts",
    "check:mcp-connections": "tsx scripts/mcp-connections.check.ts",
    "check:sqlite-store": "tsx scripts/sqlite-store.check.ts",
    "check:tool-broker": "tsx scripts/tool-broker.check.ts",
    "check:content-check": "tsx scripts/content-check.check.ts",
    "check:gemini": "tsx scripts/gemini-backend.check.ts",
    "check:anthropic": "tsx scripts/anthropic-backend.check.ts",
    "check:composio-catalog": "tsx scripts/composio-catalog.check.ts",
    "check:browser-tools": "tsx scripts/browser-tools.check.ts",
    "check:browser-integration": "tsx scripts/browser-integration.check.ts",
    "check:browser-http": "tsx scripts/browser-http.check.ts",
    "check:browser-local-http": "tsx scripts/browser-http.check.ts --local",
    "check:action-workspace": "tsx scripts/action-workspace.check.ts",
    "check:authoring-mock": "tsx scripts/authoring-mock.check.ts",
    "check:composio-readonly": "tsx --env-file-if-exists=../../.env scripts/composio-readonly-check.ts",
    "check:credentials": "tsx scripts/credentials.check.ts",
    "check:search": "tsx scripts/search.check.ts",
    "check:browser-live": "tsx --env-file-if-exists=../../.env scripts/browser-live-check.ts",
    "check:providers": "tsx --env-file-if-exists=../../.env scripts/provider-wiring.check.ts",
    "test:jev": "tsx --env-file-if-exists=../../.env scripts/test-jev.ts",
    "test:jev:routing": "tsx --env-file-if-exists=../../.env scripts/test-jev-routing.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@anthropic-ai/sdk": "^0.127.0",
    "@browserbasehq/stagehand": "^4.1.0",
    "@htn/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sentry/node": "^10.75.0",
    "ai": "^7.0.107",
    "ajv": "^8.20.0",
    "express": "^5.2.1",
    "playwright-core": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
