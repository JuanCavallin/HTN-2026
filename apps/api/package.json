{
  "name": "@htn/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "check:graph": "tsx scripts/graph-schema.check.ts",
    "check:graph-critique": "tsx scripts/graph-critique.check.ts",
    "check:analytics": "tsx scripts/analytics-parity.check.ts",
    "check:jev:decisions": "tsx scripts/jev-decisions.check.ts",
    "check:model-gateway": "tsx scripts/model-gateway.check.ts",
    "check:mcp-gateway": "tsx scripts/mcp-gateway.check.ts",
    "check:mcp-connections": "tsx scripts/mcp-connections.check.ts",
    "check:sqlite-store": "tsx scripts/sqlite-store.check.ts",
    "check:tool-broker": "tsx scripts/tool-broker.check.ts",
    "check:content-check": "tsx scripts/content-check.check.ts",
    "check:gemini": "tsx scripts/gemini-backend.check.ts",
    "check:composio-catalog": "tsx scripts/composio-catalog.check.ts",
    "check:browser-tools": "tsx scripts/browser-tools.check.ts",
    "check:providers": "tsx --env-file-if-exists=../../.env scripts/provider-wiring.check.ts",
    "test:jev": "tsx --env-file-if-exists=../../.env scripts/test-jev.ts",
    "test:jev:routing": "tsx --env-file-if-exists=../../.env scripts/test-jev-routing.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@anthropic-ai/sdk": "^0.127.0",
    "@browserbasehq/stagehand": "^4.1.0",
    "@htn/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sentry/node": "^10.75.0",
    "ai": "^7.0.107",
    "ajv": "^8.20.0",
    "express": "^5.2.1",
    "playwright-core": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.13"
  }
