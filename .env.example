# ---------------------------------------------------------------------------
# Copy to .env at the repo root.  EVERY VAR IS OPTIONAL.
# With no .env at all the app boots fully in mock mode. That is intended.
# ---------------------------------------------------------------------------

PORT=8787
WEB_ORIGIN=http://localhost:5173

# Demo-day insurance: forces every provider to mock regardless of keys below.
MOCK_ALL=false

# 0..1 — makes mock providers fail randomly so the UI's error states get built early.
MOCK_FAILURE_RATE=0

# SQLite persistence for runs, sessions, approvals, events, and MCP connections.
PERSIST_TO_DISK=true
SQLITE_PATH=../../.data/agentos.sqlite

# ---------------------------------------------------------------------------
# Providers.  MODE is one of: mock | live | disabled   (default: mock)
# A missing API key DOWNGRADES live -> mock. It never crashes the server.
# ---------------------------------------------------------------------------

# Agent runtime (Nous Research) — driven as a local subprocess over ACP
# (`uv run hermes-acp`), not an HTTP API. Live mode needs HERMES_CWD, not a key
# — set it to the absolute path of a `hermes-agent` checkout with the `acp`
# and `mcp` extras installed (`uv sync --extra acp --extra mcp --locked` there).
# Missing the checkout downgrades Hermes to mock.
HERMES_MODE=mock
HERMES_CWD=
HERMES_API_KEY=
HERMES_BASE_URL=

# Local AgentOS interception endpoints used by the isolated Hermes profile.
# Keep the MCP token distinct from the model-gateway token.
MODEL_GATEWAY_BASE_URL=http://127.0.0.1:8787/v1
MODEL_GATEWAY_API_KEY=agentos-local
MCP_GATEWAY_URL=http://127.0.0.1:8787/mcp
MCP_GATEWAY_API_KEY=agentos-mcp-local

# Jev through Vercel AI Gateway. `typesafe-ai/jev` is called through AI SDK's
# evaluation API (not the OpenAI-compatible chat-completions endpoint).
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
JEV_MODE=mock

# Legacy aliases. Prefer AI_GATEWAY_* for new setups.
JEV_API_KEY=
JEV_BASE_URL=

BROWSERBASE_MODE=mock
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

COMPOSIO_MODE=mock
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev
# Stable app-owned user ID; each user's connected accounts are isolated by this value.
COMPOSIO_USER_ID=agentos-demo-user
# Create a Gmail auth config in the Composio dashboard, then paste its ID here.
COMPOSIO_AUTH_CONFIG_ID=
# Optional reviewed bootstrap tools. Task-time discovery can register more tools safely.
COMPOSIO_TOOL_SLUGS=GMAIL_SEND_EMAIL
# Optional comma-separated discovery scope. Empty searches all toolkits.
COMPOSIO_TOOLKITS=
# Candidates fetched before policy and Jev reduce the set to the final 3-8.
COMPOSIO_DISCOVERY_LIMIT=24

# Cloud multi-model route. AgentOS/Jev still chooses from this explicit allowlist.
OPENROUTER_MODE=mock
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHEAP_MODEL=openai/gpt-5.6-luna
OPENROUTER_FRONTIER_MODEL=openai/gpt-5.6-sol

# Genuine local/private route. No API key is needed; Ollama must be running.
OLLAMA_MODE=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

ANTHROPIC_MODE=mock
ANTHROPIC_API_KEY=

# Out of scope for now. Adapter slot exists; no live.ts is implemented.
GPTZERO_MODE=disabled
GPTZERO_API_KEY=
