# ---------------------------------------------------------------------------
# Copy to .env at the repo root.  EVERY VAR IS OPTIONAL.
# With no .env at all the app boots fully in mock mode. That is intended.
# ---------------------------------------------------------------------------

PORT=8787
WEB_ORIGIN=http://localhost:5173

# Demo-day insurance: forces every provider to mock regardless of keys below.
MOCK_ALL=false

# 0..1 — makes mock providers fail randomly so the UI's error states get built early.
MOCK_FAILURE_RATE=0

# SQLite persistence for runs, sessions, approvals, events, and MCP connections.
PERSIST_TO_DISK=true
SQLITE_PATH=../../.data/agentos.sqlite

# ---------------------------------------------------------------------------
# Providers.  MODE is one of: mock | live | disabled   (default: mock)
# A missing API key DOWNGRADES live -> mock. It never crashes the server.
# ---------------------------------------------------------------------------

# Agent runtime (Nous Research) — driven as a local subprocess over ACP
# (`uv run hermes-acp`), not an HTTP API. Live mode needs HERMES_CWD, not a key
# — set it to the absolute path of a `hermes-agent` checkout with the `acp`
# and `mcp` extras installed (`uv sync --extra acp --extra mcp --locked` there).
# Missing the checkout downgrades Hermes to mock.
HERMES_MODE=mock
HERMES_CWD=
HERMES_API_KEY=
HERMES_BASE_URL=

# Local AgentOS interception endpoints used by the isolated Hermes profile.
# Keep the MCP token distinct from the model-gateway token.
MODEL_GATEWAY_BASE_URL=http://127.0.0.1:8787/v1
MODEL_GATEWAY_API_KEY=agentos-local
MCP_GATEWAY_URL=http://127.0.0.1:8787/mcp
MCP_GATEWAY_API_KEY=agentos-mcp-local

# Jev through Vercel AI Gateway. `typesafe-ai/jev` is called through AI SDK's
# evaluation API (not the OpenAI-compatible chat-completions endpoint).
# THIS IS THE ONE WAY WE REACH JEV. We do NOT use `@typesafe-ai/sdk`.
# See docs/jev.md before writing Jev code — it still cannot generate text.
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
JEV_MODE=mock

# Legacy aliases. Prefer AI_GATEWAY_* for new setups.
JEV_API_KEY=
JEV_BASE_URL=

# Cloud browser. Concurrency limit is per-project — read it off projects.list().
# Session replay/recording API is DEPRECATED (returns 404); do not plan on it.
BROWSERBASE_MODE=mock
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Local browser — the privacy path. No credentials; needs Chrome installed.
# `playwright-core` ships NO browser binaries: use channel 'chrome'.
LOCALBROWSER_MODE=mock
LOCALBROWSER_CHANNEL=chrome

# Caps for both browser backends. Sessions cost money while open.
# Browserbase's measured project concurrency limit is 25; 2 is deliberate.
BROWSER_MAX_SESSIONS=2
BROWSER_TIMEOUT_MS=30000
BROWSER_ACTION_TIMEOUT_MS=4000
BROWSER_SETTLE_MS=50
BROWSER_SETTLE_SELECT_MS=200

# Budget for ONE Jev browser decision, via the AI Gateway. Kept low on purpose:
# a browser step is interactive, and a stalled decision is worse than a
# deterministic one. On timeout the deterministic fallback takes the step.
BROWSER_DECISION_TIMEOUT_MS=2000

# Row cap on the element table. The table IS the System One request state, and
# state dominates a batched request, so this is the main latency lever.
BROWSER_MAX_ELEMENTS=60

COMPOSIO_MODE=mock
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev
# Stable app-owned user ID; each user's connected accounts are isolated by this value.
COMPOSIO_USER_ID=agentos-demo-user
# Create a Gmail auth config in the Composio dashboard, then paste its ID here.
COMPOSIO_AUTH_CONFIG_ID=
# Optional reviewed bootstrap tools. Task-time discovery can register more tools safely.
COMPOSIO_TOOL_SLUGS=GMAIL_SEND_EMAIL
# Optional comma-separated discovery scope. Empty searches all toolkits.
COMPOSIO_TOOLKITS=
# Candidates fetched before policy and Jev reduce the set to the final 3-8.
COMPOSIO_DISCOVERY_LIMIT=24

# Cloud multi-model route. AgentOS/Jev still chooses from this explicit allowlist.
OPENROUTER_MODE=mock
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHEAP_MODEL=openai/gpt-5.6-luna
OPENROUTER_FRONTIER_MODEL=openai/gpt-5.6-sol

# Genuine local/private route. No API key is needed; Ollama must be running.
OLLAMA_MODE=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

ANTHROPIC_MODE=mock
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Gemini — a DIRECT Google model route, separate from the OpenRouter catalog.
#
# Deliberately not the same thing as reaching Gemini through OpenRouter: this is
# egress to Google, so it is a distinct destination in the egress ledger and a
# distinct failure domain. Two real cloud vendors is what makes the model route
# an actual decision rather than a label.
#
# Model ids move. `GET /api/providers` verifies the two configured ids against
# what the key can actually list, so a renamed model shows up there rather than
# mid-demo. Leave MODE=mock and the routes are simply not advertised.
GEMINI_MODE=mock
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_CHEAP_MODEL=gemini-3.5-flash-lite
GEMINI_FRONTIER_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------------
# GPTZero — outbound-text authenticity check.
#
# NOT a detector on inbound content. It scores text AgentOS is about to send in
# the USER'S name (an email body, a typed form field) and escalates the action
# to a human if it reads as machine-written. The check is ESCALATE-ONLY: it can
# stop a send, never authorize one, and a GPTZero outage leaves the policy
# untouched rather than blocking a permitted action.
#
# mock returns a deterministic low score, so the whole path runs with no key.
# Set MODE=live plus a key to score for real.
GPTZERO_MODE=mock
GPTZERO_API_KEY=
# GPTZERO_BASE_URL=https://api.gptzero.me
# P(ai) at or above which an authorized outbound send stops for a human.
GPTZERO_ESCALATION_THRESHOLD=0.75

# ---------------------------------------------------------------------------
# Sentry — tracing + structured logs over the control plane.
#
# Entirely inert without a DSN: no spans, no logs, no network. One span per
# outbound provider call (wrapped around the same proxy that writes the egress
# ledger, so an untraced call is unreachable) and one structured log per run
# event (forwarded from the bus).
#
# Spans and logs carry the SHAPE of a call only — provider, destination,
# latency, tokens, cost, policy rule, and the CLASS of any redacted span. Never
# prompts, tool arguments or model output: Sentry is not a declared egress
# destination in the ledger and must not become one by accident.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1
# SENTRY_RELEASE=
