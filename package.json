{
  "name": "htn-2026",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm --filter @htn/api dev\" \"pnpm --filter @htn/web dev\"",
    "dev:api": "pnpm --filter @htn/api dev",
    "dev:web": "pnpm --filter @htn/web dev",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "build": "pnpm --filter @htn/web build",
    "smoke": "node scripts/smoke.mjs",
    "smoke:live": "node scripts/live-check.mjs",
    "check:graph": "pnpm --filter @htn/api check:graph",
    "check:analytics": "pnpm --filter @htn/api check:analytics",
    "check:jev:decisions": "pnpm --filter @htn/api check:jev:decisions",
    "check:model-gateway": "pnpm --filter @htn/api check:model-gateway",
    "check:mcp-gateway": "pnpm --filter @htn/api check:mcp-gateway",
    "check:mcp-connections": "pnpm --filter @htn/api check:mcp-connections",
    "check:sqlite-store": "pnpm --filter @htn/api check:sqlite-store",
    "check:tool-broker": "pnpm --filter @htn/api check:tool-broker",
    "check:composio-catalog": "pnpm --filter @htn/api check:composio-catalog",
    "check:providers": "pnpm --filter @htn/api check:providers",
    "test:jev": "pnpm --filter @htn/api test:jev",
    "test:jev:routing": "pnpm --filter @htn/api test:jev:routing"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
